{
  "name": "secure-file-vault",
  "version": "1.0.0",
  "description": "Serverless private file storage on AWS: S3 + KMS encryption, Cognito auth, presigned uploads/downloads, audit trail. Terraform, least-privilege IAM.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx scripts/vault-cli.ts",
    "tf:fmt": "terraform -chdir=infra fmt -recursive",
    "tf:validate": "terraform -chdir=infra init -backend=false -input=false && terraform -chdir=infra validate"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
